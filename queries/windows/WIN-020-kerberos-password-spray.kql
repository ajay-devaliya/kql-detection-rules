// WIN-020 | Windows - Kerberos password spray or user enumeration
// Severity: High | Scheduled: every 1h, looking back 1h
// MITRE ATT&CK: CredentialAccess, Discovery | T1110, T1087, T1110.003, T1087.002
// Table(s): SecurityEvent, Event

let lookback = 1h;
let AccountThreshold = 10;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where (EventID == 4771 and Status =~ "0x18") or (EventID == 4768 and Status =~ "0x6")
| extend SourceIP = trim_start(@"::ffff:", IpAddress)
| extend Pattern = iff(EventID == 4771, "Bad password (spray)", "Unknown user (enumeration)")
| summarize
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated),
    Failures = count(),
    DistinctAccounts = dcount(TargetUserName),
    Accounts = make_set(TargetUserName, 25),
    DomainControllers = make_set(Computer, 5)
    by SourceIP, Pattern
| where DistinctAccounts >= AccountThreshold
