// WIN-009 | Windows - Chain of discovery commands from one user (whoami, net, nltest, ipconfig...)
// Severity: Medium | Scheduled: every 1h, looking back 1h
// MITRE ATT&CK: Discovery | T1087, T1016, T1082, T1033, T1069
// Table(s): SecurityEvent, Event

let lookback = 1h;
let ToolThreshold = 4;
let ReconTools = dynamic(["whoami.exe", "net.exe", "net1.exe", "nltest.exe", "ipconfig.exe", "systeminfo.exe", "tasklist.exe",
    "quser.exe", "query.exe", "qwinsta.exe", "arp.exe", "route.exe", "netstat.exe", "nslookup.exe", "hostname.exe",
    "dsquery.exe", "wmic.exe", "klist.exe", "cmdkey.exe", "getmac.exe"]);
let ProcessEvents = union
    (SecurityEvent
        | where TimeGenerated > ago(lookback)
        | where EventID == 4688
        | project TimeGenerated, Computer, AccountName = SubjectUserName, AccountDomain = SubjectDomainName,
            ProcessName = NewProcessName, OriginalFileName = "", CommandLine, ParentProcessName, EventSource = "Security 4688"),
    (Event
        | where TimeGenerated > ago(lookback)
        | where Source == "Microsoft-Windows-Sysmon" and EventID == 1
        | extend X = parse_xml(EventData)
        | mv-apply D = X.DataItem.EventData.Data on (summarize Props = make_bag(bag_pack(tostring(D["@Name"]), tostring(D["#text"]))))
        | extend U = split(tostring(Props.User), "\\")
        | project TimeGenerated, Computer,
            AccountName = tostring(U[-1]), AccountDomain = iff(array_length(U) > 1, tostring(U[0]), ""),
            ProcessName = tostring(Props.Image), OriginalFileName = tostring(Props.OriginalFileName),
            CommandLine = tostring(Props.CommandLine), ParentProcessName = tostring(Props.ParentImage), EventSource = "Sysmon 1")
    | extend ProcessFile = tolower(tostring(split(ProcessName, "\\")[-1])),
             ParentFile = tolower(tostring(split(ParentProcessName, "\\")[-1]));
ProcessEvents
| where ProcessFile in (ReconTools)
| where AccountName !endswith "$"
| summarize
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated),
    DistinctTools = dcount(ProcessFile),
    Tools = make_set(ProcessFile, 20),
    CommandLines = make_set(CommandLine, 20),
    ParentProcesses = make_set(ParentProcessName, 10)
    by Computer, AccountName, AccountDomain, Window = bin(TimeGenerated, 15m)
| where DistinctTools >= ToolThreshold
| project-away Window
