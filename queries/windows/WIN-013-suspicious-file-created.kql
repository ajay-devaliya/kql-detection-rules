// WIN-013 | Windows - Executable or script dropped by a script host, Office or LOLBin
// Severity: Medium | Scheduled: every 1h, looking back 1h
// MITRE ATT&CK: Execution, Persistence, CommandAndControl | T1105, T1547, T1547.001
// Table(s): Event

let lookback = 1h;
let DroppingProcesses = dynamic(["powershell.exe", "pwsh.exe", "cmd.exe", "wscript.exe", "cscript.exe", "mshta.exe", "rundll32.exe",
    "regsvr32.exe", "certutil.exe", "bitsadmin.exe", "winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe", "msbuild.exe", "curl.exe"]);
Event
| where TimeGenerated > ago(lookback)
| where Source == "Microsoft-Windows-Sysmon" and EventID == 11
| extend X = parse_xml(EventData)
| mv-apply D = X.DataItem.EventData.Data on (summarize Props = make_bag(bag_pack(tostring(D["@Name"]), tostring(D["#text"]))))
| extend Image = tostring(Props.Image), TargetFilename = tostring(Props.TargetFilename),
         U = split(tostring(Props.User), "\\")
| extend ImageFile = tolower(tostring(split(Image, "\\")[-1]))
| where TargetFilename matches regex @"(?i)\.(exe|dll|scr|ps1|vbs|vbe|js|jse|hta|bat|cmd|lnk|iso|img|msi)$"
| where ImageFile in (DroppingProcesses) or TargetFilename matches regex @"(?i)\\start menu\\programs\\startup\\"
| extend AccountName = tostring(U[-1]), AccountDomain = iff(array_length(U) > 1, tostring(U[0]), "")
| summarize
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated),
    FilesCreated = dcount(TargetFilename),
    Files = make_set(TargetFilename, 20)
    by Computer, AccountName, AccountDomain, CreatingProcess = Image
