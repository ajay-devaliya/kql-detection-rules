// WIN-023 | Windows - Account added to a privileged group
// Severity: High | Scheduled: every 15m, looking back 15m
// MITRE ATT&CK: Persistence, PrivilegeEscalation | T1098, T1098.007
// Table(s): SecurityEvent, Event

let lookback = 15m;
let PrivilegedGroups = dynamic(["Administrators", "Domain Admins", "Enterprise Admins", "Schema Admins", "Account Operators",
    "Backup Operators", "Server Operators", "Print Operators", "DnsAdmins", "Group Policy Creator Owners", "Remote Desktop Users",
    "Enterprise Key Admins", "Key Admins"]);
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4728, 4732, 4756)
| where TargetUserName in~ (PrivilegedGroups)
| extend AddedMember = iff(isnotempty(MemberName) and MemberName != "-", MemberName, MemberSid)
| summarize
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated),
    Changes = count(),
    AddedMembers = make_set(AddedMember, 10),
    Groups = make_set(TargetUserName, 10)
    by Computer, AccountName = SubjectUserName, AccountDomain = SubjectDomainName
